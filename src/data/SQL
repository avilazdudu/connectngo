    id          SERIAL PRIMARY KEY,
    ong_id      BIGINT   NOT NULL UNIQUE REFERENCES ongs(id) ON DELETE CASCADE,
    ordem       SMALLINT NOT NULL,
    criado_em   TIMESTAMPTZ NOT NULL DEFAULT now()
