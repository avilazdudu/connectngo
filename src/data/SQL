-- =====================================================================
-- 6. TRANSACOES (origem sempre usuário; destino = usuário OU produto)
-- =====================================================================
CREATE TABLE transacoes (
    id                    VARCHAR(10) PRIMARY KEY,
    origem                BIGINT NOT NULL REFERENCES usuarios(id),
    destino_usuario_id    BIGINT REFERENCES usuarios(id),
    destino_produto_id    VARCHAR(10) REFERENCES produtos(id),
    valor                 INTEGER NOT NULL CHECK (valor > 0),
    tipo                  VARCHAR(20) NOT NULL CHECK (tipo IN ('doacao','resgate','repasse')),
    data                  DATE NOT NULL,
    criado_em             TIMESTAMPTZ NOT NULL DEFAULT now(),
    CONSTRAINT chk_destino_unico CHECK (
        (destino_usuario_id IS NOT NULL AND destino_produto_id IS NULL)
        OR
        (destino_usuario_id IS NULL AND destino_produto_id IS NOT NULL)
    )
);
 
CREATE INDEX idx_transacoes_origem ON transacoes(origem);
CREATE INDEX idx_transacoes_destino_usuario ON transacoes(destino_usuario_id);
CREATE INDEX idx_transacoes_destino_produto ON transacoes(destino_produto_id);
CREATE INDEX idx_transacoes_data ON transacoes(data);
 
