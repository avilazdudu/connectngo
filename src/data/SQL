-- =====================================================================
-- 4. EMPRESAS (dados específicos de empresa, 1:1 com usuarios)
-- =====================================================================
CREATE TABLE empresas (
    id                    BIGINT PRIMARY KEY REFERENCES usuarios(id) ON DELETE CASCADE,
    creditos_acumulados   INTEGER NOT NULL DEFAULT 0 CHECK (creditos_acumulados >= 0),
    criado_em             TIMESTAMPTZ NOT NULL DEFAULT now()
);
 
