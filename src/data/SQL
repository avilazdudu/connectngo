-- =====================================================================
-- 7. METRICAS_PLATAFORMA (singleton — um único registro de indicadores gerais)
-- =====================================================================
CREATE TABLE metricas_plataforma (
    id                          SMALLINT PRIMARY KEY DEFAULT 1 CHECK (id = 1),
    ongs_ativas                 BIGINT      NOT NULL,
    impacto_economico_bilhoes   NUMERIC(10,2) NOT NULL,
    empregos_gerados            BIGINT      NOT NULL,
    estados_atendidos           SMALLINT    NOT NULL,
    atualizado_em               TIMESTAMPTZ NOT NULL DEFAULT now()
);
 
