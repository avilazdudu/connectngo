-- =====================================================================
-- 8. BADGES (catálogo de conquistas)
-- =====================================================================
CREATE TABLE badges (
    id          VARCHAR(40) PRIMARY KEY,
    nome        VARCHAR(80) NOT NULL,
    icone       VARCHAR(10),
    descricao   TEXT,
    criterio    TEXT,
    criado_em   TIMESTAMPTZ NOT NULL DEFAULT now()
);
 
