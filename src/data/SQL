--      (email definido como NULL, por não existir no JSON original)
--   3) ongsDestaque.json -> tabela separada ongs_destaque com FK para ongs
-- =====================================================================
 
BEGIN;
 
-- =====================================================================
-- 1. USUARIOS (tabela base — doador / ong / empresa)
-- =====================================================================
CREATE TABLE usuarios (
    id              BIGINT PRIMARY KEY,
    nome            VARCHAR(150) NOT NULL,
    tipo            VARCHAR(20)  NOT NULL CHECK (tipo IN ('doador','ong','empresa')),
    email           VARCHAR(150) UNIQUE,
    saldo_creditos  INTEGER      NOT NULL DEFAULT 0 CHECK (saldo_creditos >= 0),
    criado_em       TIMESTAMPTZ  NOT NULL DEFAULT now()
);
 
COMMENT ON TABLE usuarios IS 'Tabela base de todos os usuários da plataforma (doadores, ONGs e empresas)';
COMMENT ON COLUMN usuarios.email IS 'NULL para registros gerados automaticamente a partir de ongs.json (não existiam em usuarios.json)';
 
