-- =====================================================================
-- 2. ONGS (dados específicos de ONG, 1:1 com usuarios)
-- =====================================================================
CREATE TABLE ongs (
    id                  BIGINT PRIMARY KEY REFERENCES usuarios(id) ON DELETE CASCADE,
    cnpj                VARCHAR(18)  NOT NULL UNIQUE,
    categoria           VARCHAR(60)  NOT NULL,
    regiao              VARCHAR(30)  NOT NULL,
    descricao           TEXT,
    creditos_recebidos  INTEGER      NOT NULL DEFAULT 0 CHECK (creditos_recebidos >= 0),
    beneficiarios       INTEGER      NOT NULL DEFAULT 0 CHECK (beneficiarios >= 0),
    imagem              TEXT,
    criado_em           TIMESTAMPTZ  NOT NULL DEFAULT now()
);
 
CREATE INDEX idx_ongs_categoria ON ongs(categoria);
CREATE INDEX idx_ongs_regiao ON ongs(regiao);
 
